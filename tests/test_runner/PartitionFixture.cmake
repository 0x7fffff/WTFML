# Independent fixture for partition completeness, overlap and visual exclusion.
find_program(PARTITION_CMAKE NAMES cmake REQUIRED)
foreach(group IN ITEMS ci-app ci-core ci-ui ci-integration)
    add_test("fixture.${group}" "${PARTITION_CMAKE}" -E true)
    if(group STREQUAL "ci-app" AND "$ENV{WTFML_PARTITION_FIXTURE_CASE}" STREQUAL "empty")
        set_tests_properties("fixture.${group}" PROPERTIES LABELS "other")
    else()
        set_tests_properties("fixture.${group}" PROPERTIES LABELS "${group}")
    endif()
endforeach()
add_test(fixture.visual "${PARTITION_CMAKE}" -E false)
set_tests_properties(fixture.visual PROPERTIES LABELS "ci-ui;visual")
if("$ENV{WTFML_PARTITION_FIXTURE_CASE}" STREQUAL "missing")
    add_test(fixture.unassigned "${PARTITION_CMAKE}" -E true)
elseif("$ENV{WTFML_PARTITION_FIXTURE_CASE}" STREQUAL "duplicate")
    set_tests_properties(fixture.ci-ui PROPERTIES LABELS "ci-ui;ci-core")
endif()
